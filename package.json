{
  "name": "wa-test",
  "version": "1.0.0",
  "description": "WhatsApp messaging service para Queirolo Autos (Twilio + Express + SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node scripts/dump-schema.js",
    "db:verify": "node scripts/verify-db.js",
    "db:debug": "node scripts/debug-db.js",
    "import": "node scripts/import-csv.js",
    "n8n:list": "node scripts/n8n/workflow-manager.js list",
    "n8n:get": "node scripts/n8n/workflow-manager.js get",
    "n8n:create": "node scripts/n8n/workflow-manager.js create",
    "n8n:update": "node scripts/n8n/workflow-manager.js update",
    "n8n:delete": "node scripts/n8n/workflow-manager.js delete",
    "n8n:activate": "node scripts/n8n/workflow-manager.js activate",
    "n8n:deactivate": "node scripts/n8n/workflow-manager.js deactivate",
    "n8n:duplicate": "node scripts/n8n/workflow-manager.js duplicate"
  },
  "keywords": [
    "whatsapp",
    "twilio",
    "messaging"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "multer": "^2.0.2",
    "twilio": "^5.11.2"
  }
}
